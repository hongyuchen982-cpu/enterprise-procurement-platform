COMPOSE_PROJECT_NAME=enterprise-procurement-platform

API_PORT=8000
WORKER_HEALTH_PORT=8001
FRONTEND_PORT=5173

MYSQL_PORT=3306
MYSQL_DATABASE=procurement
MYSQL_USER=procurement
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-root-me-local-only

REDIS_PORT=6379
REDIS_PASSWORD=change-redis-me-local-only

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=procurement
RABBITMQ_PASSWORD=change-rabbit-me-local-only
RABBITMQ_VHOST=procurement

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=procurement-minio
MINIO_ROOT_PASSWORD=change-minio-me-local-only
MINIO_BUCKET=procurement-files

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-before-any-shared-deployment
CORS_ORIGINS=http://localhost:5173
